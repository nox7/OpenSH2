/* Original menu coordinates are authored at 1024 x 768. The controller fits this
   frame uniformly inside the viewport; layout stays here rather than in C#. */
#menu-frame {
    position: absolute; width: 1024px; height: 768px;
    transform-origin: 0 0; overflow: hidden;
    background-color: black;
}
.sidebar { position: absolute; top: 0; bottom: 0; background-size: cover; }
.sidebar.left { left: 0; }
.sidebar.right { right: 0; }
#background-video { position: absolute; right: 0; top: 0; width: 768px; height: 768px; }
.curtain { position: absolute; left: 0; top: 0; width: 381px; height: 768px; }
#menu-column {
    position: absolute; left: 0; top: 0; width: 381px; height: 768px;
    align-items: center; padding-top: 30px; padding-right: 20px;
}
#logo { width: 350px; height: 190px; margin-bottom: 22px; }
.menu-button {
    width: 320px; height: 60px; flex-shrink: 0;
    margin: 0 0 12px 0; padding: 0;
    border-width: 0; border-radius: 0;
    background-color: transparent; background-size: 100% 100%;
    align-items: center; justify-content: center;
    color: rgb(255, 244, 214); font-size: 24px;
}
.menu-button:hover { background-color: transparent; }
.menu-button:active { background-color: transparent; }
.menu-button:disabled { opacity: 0.6; }
.menu-button > Label { -unity-text-align: middle-center; }
.button-highlight {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-size: 100% 100%; opacity: 0;
}
.menu-button:hover > .button-highlight, .menu-button:focus > .button-highlight { opacity: 1; }
